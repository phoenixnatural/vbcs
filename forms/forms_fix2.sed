/"KEY-LISTVAL".*EXIT_REPLACEMENT_BLK/c\
      <Trigger Name="KEY-LISTVAL" TriggerText="DECLARE rg RECORDGROUP; n NUMBER; BEGIN rg := FIND_GROUP('RT_OLD'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_OLD', 'SELECT person_id, employee_number || '' - '' || full_name emp_disp, actual_termination_date term_date, department_segment3 department FROM apps.asi_fdoa_exit_employees_v WHERE supervisor_id = ' || :EXIT_REPLACEMENT_BLK.LOGGED_PERSON_ID || ' ORDER BY full_name'); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_OLD_EMP_EXIT', GROUP_NAME, 'RT_OLD'); rg := FIND_GROUP('RT_NEW'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_NEW', 'SELECT emp_person_id person_id, emp_employee_number || '' - '' || emp_full_name emp_disp FROM apps.asi_fdoa_rm_direct_reports_v WHERE rm_person_id = ' || :EXIT_REPLACEMENT_BLK.LOGGED_PERSON_ID || ' UNION ALL SELECT ' || :EXIT_REPLACEMENT_BLK.LOGGED_PERSON_ID || ', ''*** Self (RM) ***'' FROM dual ORDER BY 2'); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_NEW_EMP_RM', GROUP_NAME, 'RT_NEW'); APP_STANDARD.EVENT('KEY-LISTVAL'); END;" DisplayInKeyboardHelp="true" FireInQuery="true"/>
/"KEY-LISTVAL".*MOVEMENT_REPLACEMENT_BLK/c\
      <Trigger Name="KEY-LISTVAL" TriggerText="DECLARE rg RECORDGROUP; n NUMBER; BEGIN rg := FIND_GROUP('RT_OLD'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_OLD', 'SELECT person_id, employee_number || '' - '' || full_name emp_disp, effective_date eff_date, old_segment3 old_dept, new_segment3 new_dept FROM apps.asi_fdoa_movement_emp_v WHERE old_rm_supervisor_id = ' || :MOVEMENT_REPLACEMENT_BLK.LOGGED_PERSON_ID || ' ORDER BY full_name'); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_OLD_EMP_MOVE', GROUP_NAME, 'RT_OLD'); rg := FIND_GROUP('RT_NEW'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_NEW', 'SELECT emp_person_id person_id, emp_employee_number || '' - '' || emp_full_name emp_disp FROM apps.asi_fdoa_rm_direct_reports_v WHERE rm_person_id = ' || :MOVEMENT_REPLACEMENT_BLK.LOGGED_PERSON_ID || ' UNION ALL SELECT ' || :MOVEMENT_REPLACEMENT_BLK.LOGGED_PERSON_ID || ', ''*** Self (RM) ***'' FROM dual ORDER BY 2'); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_NEW_EMP_RM', GROUP_NAME, 'RT_NEW'); APP_STANDARD.EVENT('KEY-LISTVAL'); END;" DisplayInKeyboardHelp="true" FireInQuery="true"/>
/"KEY-LISTVAL".*SU_REPLACEMENT_BLK/c\
      <Trigger Name="KEY-LISTVAL" TriggerText="DECLARE rg RECORDGROUP; n NUMBER; l_q VARCHAR2(2000); BEGIN rg := FIND_GROUP('RT_DOC'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_DOC', 'SELECT lookup_code, meaning FROM apps.fnd_lookup_values WHERE lookup_type = ''ASI_FDOA_DOC_TYPE_LK'' AND language = USERENV(''LANG'') AND enabled_flag = ''Y'' AND lookup_code IN (''EXIT'',''MOVEMENT'') ORDER BY 2'); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_DOC_TYPE', GROUP_NAME, 'RT_DOC'); IF NVL(:SU_REPLACEMENT_BLK.DOC_TYPE,'EXIT') = 'MOVEMENT' THEN l_q := 'SELECT person_id, employee_number || '' - '' || full_name emp_disp, effective_date key_date FROM apps.asi_fdoa_movement_emp_v ORDER BY 2'; ELSE l_q := 'SELECT person_id, employee_number || '' - '' || full_name emp_disp, actual_termination_date key_date FROM apps.asi_fdoa_exit_employees_v ORDER BY 2'; END IF; rg := FIND_GROUP('RT_OLD'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_OLD', l_q); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_OLD_EMP_SU', GROUP_NAME, 'RT_OLD'); rg := FIND_GROUP('RT_NEW'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_NEW', 'SELECT ppl.person_id, ppl.employee_number || '' - '' || ppl.full_name emp_disp FROM apps.per_all_people_f ppl, apps.per_all_assignments_f paf, apps.per_assignment_status_types past WHERE TRUNC(SYSDATE) BETWEEN ppl.effective_start_date AND ppl.effective_end_date AND TRUNC(SYSDATE) BETWEEN paf.effective_start_date AND paf.effective_end_date AND paf.person_id = ppl.person_id AND paf.assignment_type = ''E'' AND paf.primary_flag = ''Y'' AND past.assignment_status_type_id = paf.assignment_status_type_id AND past.per_system_status = ''ACTIVE_ASSIGN'' ORDER BY 2'); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_NEW_EMP_SU', GROUP_NAME, 'RT_NEW'); APP_STANDARD.EVENT('KEY-LISTVAL'); END;" DisplayInKeyboardHelp="true" FireInQuery="true"/>
