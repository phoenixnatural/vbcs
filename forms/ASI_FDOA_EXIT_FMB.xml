      <Trigger Name="KEY-LISTVAL" TriggerText="DECLARE rg RECORDGROUP; n NUMBER; BEGIN rg := FIND_GROUP('RT_OLD'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_OLD', 'SELECT person_id, full_name emp_name, employee_number emp_num, actual_termination_date term_date, department_segment3 department FROM apps.asi_fdoa_exit_employees_v WHERE supervisor_id = ' || :EXIT_REPLACEMENT_BLK.LOGGED_PERSON_ID || ' ORDER BY full_name'); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_OLD_EMP_EXIT', GROUP_NAME, 'RT_OLD'); rg := FIND_GROUP('RT_NEW'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_NEW', 'SELECT emp_person_id person_id, emp_full_name emp_name, emp_employee_number emp_num FROM apps.asi_fdoa_rm_direct_reports_v WHERE rm_person_id = ' || :EXIT_REPLACEMENT_BLK.LOGGED_PERSON_ID || ' UNION ALL SELECT person_id, ''*** Self (RM) ***'' emp_name, employee_number emp_num FROM apps.per_all_people_f WHERE person_id = ' || :EXIT_REPLACEMENT_BLK.LOGGED_PERSON_ID || ' AND TRUNC(SYSDATE) BETWEEN effective_start_date AND effective_end_date ORDER BY 2'); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_NEW_EMP_RM', GROUP_NAME, 'RT_NEW'); APP_STANDARD.EVENT('KEY-LISTVAL'); END;" DisplayInKeyboardHelp="true" FireInQuery="true"/>
