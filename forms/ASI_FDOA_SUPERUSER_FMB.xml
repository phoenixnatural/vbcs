            <Trigger Name="WHEN-VALIDATE-ITEM" TriggerText="BEGIN&amp;#10;  IF :SU_REPLACEMENT_BLK.OLD_PERSON_ID IS NULL THEN RETURN; END IF;&amp;#10;  DECLARE&amp;#10;    l_cnt NUMBER;&amp;#10;  BEGIN&amp;#10;    IF NVL(:SU_REPLACEMENT_BLK.DOC_TYPE,'EXIT') = 'MOVEMENT' THEN&amp;#10;      SELECT COUNT(*) INTO l_cnt&amp;#10;        FROM apps.asi_fdoa_movement_emp_v&amp;#10;       WHERE person_id = :SU_REPLACEMENT_BLK.OLD_PERSON_ID;&amp;#10;    ELSE&amp;#10;      SELECT COUNT(*) INTO l_cnt&amp;#10;        FROM apps.asi_fdoa_exit_employees_v&amp;#10;       WHERE person_id = :SU_REPLACEMENT_BLK.OLD_PERSON_ID;&amp;#10;    END IF;&amp;#10;    IF l_cnt = 0 THEN&amp;#10;      FND_MESSAGE.SET_STRING('CR# 2026-02-0585 - The selected employee is not in the selected Document Type scope.');&amp;#10;      FND_MESSAGE.SHOW;&amp;#10;      RAISE FORM_TRIGGER_FAILURE;&amp;#10;    END IF;&amp;#10;  END;&amp;#10;END;" DisplayInKeyboardHelp="true"/>
