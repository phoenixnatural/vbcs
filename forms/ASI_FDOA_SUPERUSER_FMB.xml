            <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="DECLARE&amp;#10;  l_replacement_id  NUMBER;&amp;#10;BEGIN&amp;#10;  IF :SU_REPLACEMENT_BLK.DOC_TYPE IS NULL&amp;#10;     OR :SU_REPLACEMENT_BLK.OLD_PERSON_ID IS NULL&amp;#10;     OR :SU_REPLACEMENT_BLK.NEW_PERSON_ID IS NULL THEN&amp;#10;    FND_MESSAGE.SET_STRING('CR# 2026-02-0585 - Document Type, Old Employee and New Employee are mandatory.');&amp;#10;    FND_MESSAGE.SHOW;&amp;#10;    RAISE FORM_TRIGGER_FAILURE;&amp;#10;  END IF;&amp;#10;  apps.asi_fdoa_replacement_pkg.OVERRIDE_BY_SUPERUSER&amp;#10;    ( p_doc_type             => :SU_REPLACEMENT_BLK.DOC_TYPE&amp;#10;    , p_old_person_id        => :SU_REPLACEMENT_BLK.OLD_PERSON_ID&amp;#10;    , p_new_person_id        => :SU_REPLACEMENT_BLK.NEW_PERSON_ID&amp;#10;    , p_entered_by_person_id => :GLOBAL.LOGGED_IN_PERSON_ID&amp;#10;    , p_remarks              => :SU_REPLACEMENT_BLK.REMARKS&amp;#10;    , p_org_id               => FND_GLOBAL.ORG_ID&amp;#10;    , x_replacement_id       => l_replacement_id );&amp;#10;  COMMIT;&amp;#10;  FND_MESSAGE.SET_STRING('CR# 2026-02-0585 - Override saved (ID ' || l_replacement_id || ').');&amp;#10;  FND_MESSAGE.SHOW;&amp;#10;  GO_BLOCK('SU_REPLACEMENT_BLK');&amp;#10;  CLEAR_BLOCK(NO_VALIDATE);&amp;#10;  :SU_REPLACEMENT_BLK.LOGGED_PERSON_ID := FND_GLOBAL.EMPLOYEE_ID;&amp;#10;  :SU_REPLACEMENT_BLK.DOC_TYPE := 'EXIT';&amp;#10;EXCEPTION&amp;#10;  WHEN OTHERS THEN&amp;#10;    ROLLBACK;&amp;#10;    FND_MESSAGE.SET_STRING(SUBSTR(SQLERRM, INSTR(SQLERRM,':')+1, 240));&amp;#10;    FND_MESSAGE.SHOW;&amp;#10;    RAISE FORM_TRIGGER_FAILURE;&amp;#10;END;" DisplayInKeyboardHelp="true"/>
         </Item>
