      <Trigger Name="KEY-LISTVAL" TriggerText="DECLARE rg RECORDGROUP; n NUMBER; l_q VARCHAR2(2000); BEGIN rg := FIND_GROUP('RT_DOC'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_DOC', 'SELECT lookup_code, meaning FROM apps.fnd_lookup_values WHERE lookup_type = ''ASI_FDOA_DOC_TYPE_LK'' AND language = USERENV(''LANG'') AND enabled_flag = ''Y'' AND lookup_code IN (''EXIT'',''MOVEMENT'') ORDER BY 2'); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_DOC_TYPE', GROUP_NAME, 'RT_DOC'); IF NVL(:SU_REPLACEMENT_BLK.DOC_TYPE,'EXIT') = 'MOVEMENT' THEN l_q := 'SELECT person_id, full_name emp_name, employee_number emp_num, effective_date key_date FROM apps.asi_fdoa_movement_emp_v ORDER BY 2'; ELSE l_q := 'SELECT person_id, full_name emp_name, employee_number emp_num, actual_termination_date key_date FROM apps.asi_fdoa_exit_employees_v ORDER BY 2'; END IF; rg := FIND_GROUP('RT_OLD'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_OLD', l_q); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_OLD_EMP_SU', GROUP_NAME, 'RT_OLD'); rg := FIND_GROUP('RT_NEW'); IF NOT ID_NULL(rg) THEN DELETE_GROUP(rg); END IF; rg := CREATE_GROUP_FROM_QUERY('RT_NEW', 'SELECT ppl.person_id, ppl.full_name emp_name, ppl.employee_number emp_num FROM apps.per_all_people_f ppl, apps.per_all_assignments_f paf, apps.per_assignment_status_types past WHERE TRUNC(SYSDATE) BETWEEN ppl.effective_start_date AND ppl.effective_end_date AND TRUNC(SYSDATE) BETWEEN paf.effective_start_date AND paf.effective_end_date AND paf.person_id = ppl.person_id AND paf.assignment_type = ''E'' AND paf.primary_flag = ''Y'' AND past.assignment_status_type_id = paf.assignment_status_type_id AND past.per_system_status = ''ACTIVE_ASSIGN'' ORDER BY 2'); n := POPULATE_GROUP(rg); SET_LOV_PROPERTY('LOV_NEW_EMP_SU', GROUP_NAME, 'RT_NEW'); APP_STANDARD.EVENT('KEY-LISTVAL'); END;" DisplayInKeyboardHelp="true" FireInQuery="true"/>
